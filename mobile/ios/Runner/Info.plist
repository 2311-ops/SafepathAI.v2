<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SafePath uses your location while the app is open so your family can see that you are safe.</string>
	<!-- Background location is requested only after a person enables safe
	     zones or during an active SOS; neither use starts a permanent tracker. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>When you enable safe zones, SafePath uses your location in the background to recognize entry and exit. During an active SOS, it shares live location with your guardians so help can find you.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SafePath uses your photos to set your profile picture.</string>
	<!-- safepathai:// deep link — handles both the password-reset email link
	     and the Google OAuth redirect-back (01-08-PLAN.md D-08-3: this scheme
	     was previously unregistered on iOS, so neither flow could return into
	     the app; this closes that gap for both). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>safepathai</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SafePath AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SafePath AI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Remote-notification background mode — required for FCM (03-06) so a
	     data message can be processed while the app is backgrounded. The
	     APNs authentication key upload and the Xcode Push Notifications
	     capability (Signing & Capabilities) are separate human setup steps
	     recorded in 03-06-PLAN.md's user_setup block; without them this mode
	     alone does not make push delivery work end-to-end. -->
	<!-- "location" is added alongside the existing "remote-notification" mode
	     so the flutter_foreground_task-backed live-location stream
	     (03-08, D-31) can keep running in the background during an active
	     SOS window. This is Android's D-33 gap on iOS's own terms: iOS
	     background location modes already keep the process alive for
	     location updates independent of the recents-screen swipe gesture
	     that motivates D-33's stopWithTask fix on Android, so no separate
	     iOS "force-kill survival" mechanism is needed here. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
